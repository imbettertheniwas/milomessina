# Set on the server only, in the Vercel project's environment variables.
CAMPUSWARS_ADMIN_PASSWORD=
CAMPUSWARS_ADMIN_USERNAME=village

# Authorized fomo access, server only. Never use a visitor session or client-side token.
FOMO_MARKET_ACCESS_TOKEN=


# Isolated HQ visit requests. Missing values disable the feature.
# Use DIFFERENT values and a DIFFERENT spreadsheet on preview deployments.
VISITS_PUBLIC_ORIGIN=
VISITS_STORAGE_URL=
VISITS_SERVICE_SECRET=
VISITS_SESSION_SECRET=
VISITS_ADMIN_PASSWORD=
