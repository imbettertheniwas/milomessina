{
  "manifest_version": 3,
  "name": "FOMO Campus → Eyes",
  "version": "1.1.0",
  "description": "Refresh campus clan names and member counts in milomessina.com/eyes using your signed-in FOMO tab.",
  "permissions": [
    "alarms",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://fomo.family/*",
    "https://milomessina.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FOMO clan sync"
  }
}
