# Configure these in your host's secret manager. Never commit populated values.
NODE_ENV=production
DATABASE_URL=
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=com.courtside.app
APPLE_APP_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_KEY_PATH=/run/secrets/apple-signin.p8
APNS_KEY_ID=
APNS_KEY_PATH=/run/secrets/apns.p8
APPLE_ROOT_CERT_PATHS=/run/secrets/AppleRootCA-G3.cer
TOKEN_ENCRYPTION_KEY=
ADMIN_TOKEN=
PRIVACY_URL=
TERMS_URL=
SUPPORT_EMAIL=
# Only enable sources after collector verification on the deployment host.
LIVE_SOURCES=
ENABLE_SALES=false

# Server-only AI configuration. Never put the API key in the iOS app.
ENABLE_COACH=false
OPENAI_API_KEY=
OPENAI_MODEL=
