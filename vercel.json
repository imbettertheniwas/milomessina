{
  "functions": {
    "api/campuswars.mjs": {
      "maxDuration": 30
    },
    "api/commits.mjs": {
      "maxDuration": 30
    },
    "api/visits.mjs": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/internal/beta/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/internal",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/hqvisitform/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/r/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/arya/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/internal/beta", "destination": "/invoice/beta.html" },
    { "source": "/internal/beta/", "destination": "/invoice/beta.html" },
    {
      "source": "/internal",
      "destination": "/invoice/index.html"
    },
    {
      "source": "/internal/",
      "destination": "/invoice/index.html"
    },
    {
      "source": "/hqvisitform",
      "destination": "/hqvisitform/index.html"
    },
    {
      "source": "/r/:code",
      "destination": "/r/index.html"
    },
    {
      "source": "/arya",
      "destination": "/arya/index.html"
    },
    {
      "source": "/arya/",
      "destination": "/arya/index.html"
    }
  ]
}
